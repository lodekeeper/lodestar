# Lodestar with V8 Pointer Compression
# Based on platformatic/node-caged (Node 25 + --experimental-enable-pointer-compression)
# Expected: ~50% heap reduction, 2-4% latency overhead

FROM platformatic/node-caged:25-slim AS build

# Install build tools and pnpm (corepack removed in Node 25)
RUN apt-get update && apt-get install -y python3 make g++ git && rm -rf /var/lib/apt/lists/*
RUN npm install -g pnpm@9

WORKDIR /app

# Copy everything and install+build
COPY . .
RUN pnpm install --frozen-lockfile
RUN pnpm build

# --- Production stage ---
FROM platformatic/node-caged:25-slim

RUN npm install -g pnpm@9
WORKDIR /app

COPY --from=build /app .
RUN pnpm prune --prod

# With pointer compression, 4GB is the cage limit per isolate.
# This gives ~8GB equivalent uncompressed capacity.
ENV NODE_OPTIONS="--max-old-space-size=4096"

ENTRYPOINT ["node", "./packages/cli/bin/lodestar.js"]
